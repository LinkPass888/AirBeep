+/// # Safety
+/// All pointer args must be null or valid for their documented types.
+pub unsafe fn read_file(
+    pairing_path: *const c_char,
+    ios_path: *const c_char,
+    log_cb: ALLogCallback,
+    ctx: *mut c_void,
+    out_error: *mut *mut c_char,
+) -> Result<Vec<u8>, String> {
+    let pairing_path = opt_str(pairing_path, "airlift_pairing.plist");
+    let ios_path = opt_str(ios_path, "");
+    let ctx_usize = ctx as usize;
+
+    if ios_path.is_empty() || !ios_path.starts_with('/') {
+        return Err("ios_path must be an absolute path".into());
+    }
+
+    let res = crate::ffi_util::run_with_large_stack("al_exploit_read_file", move || {
+        let logger = Logger { cb: log_cb, ctx: ctx_usize as *mut c_void };
+        idevice_ffi::run_sync_local(exploit_read_file(pairing_path, ios_path, &logger))
+    });
+
+    match res {
+        Ok(result) => result,
+        Err(panic_msg) => {
+            if !out_error.is_null() {
+                *out_error = cstr(panic_msg.clone());
+            }
+            Err(panic_msg)
+        }
+    }
+}
