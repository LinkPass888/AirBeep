+/// Read one absolute iOS file through the AirTraffic escape and recover it in Media.
+///
+/// `out_data` receives a heap allocation of `out_len` bytes. Release it with
+/// `al_bytes_free(out_data, out_len)` after copying the bytes.
+#[no_mangle]
+pub unsafe extern "C" fn al_exploit_read_file(
+    pairing_path: *const c_char,
+    ios_path: *const c_char,
+    log_cb: exploit::ALLogCallback,
+    ctx: *mut c_void,
+    out_data: *mut *mut u8,
+    out_len: *mut usize,
+    out_error: *mut *mut c_char,
+) -> i32 {
+    if out_data.is_null() || out_len.is_null() {
+        if !out_error.is_null() {
+            *out_error = ffi_util::cstr("out_data and out_len must not be null");
+        }
+        return 2;
+    }
+    *out_data = std::ptr::null_mut();
+    *out_len = 0;
+
+    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        exploit::read_file(pairing_path, ios_path, log_cb, ctx, out_error)
+    }));
+    match res {
+        Ok(Ok(data)) => {
+            let mut boxed = data.into_boxed_slice();
+            let len = boxed.len();
+            let ptr = boxed.as_mut_ptr();
+            std::mem::forget(boxed);
+            *out_data = ptr;
+            *out_len = len;
+            0
+        }
+        Ok(Err(e)) => {
+            if !out_error.is_null() {
+                *out_error = ffi_util::cstr(e);
+            }
+            1
+        }
+        Err(e) => {
+            if !out_error.is_null() {
+                *out_error = ffi_util::cstr(format!("Rust panic in al_exploit_read_file: {e:?}"));
+            }
+            1
+        }
+    }
+}
+
+/// Free bytes returned by `al_exploit_read_file`.
+#[no_mangle]
+pub unsafe extern "C" fn al_bytes_free(ptr: *mut u8, len: usize) {
+    if ptr.is_null() {
+        return;
+    }
+    let slice = std::ptr::slice_from_raw_parts_mut(ptr, len);
+    let _ = Box::from_raw(slice);
+}
